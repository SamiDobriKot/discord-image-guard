# Токен бота: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Путь к локальной базе SQLite
DATABASE_PATH=data/guard.sqlite3

# Сколько часов хранить изображения/хеши (0 — без ограничения)
HASH_RETENTION_HOURS=24

# Игнорировать сообщения других ботов
IGNORE_BOTS=true

# Максимальный размер скачиваемого изображения, МБ
MAX_DOWNLOAD_MB=32

# Сколько изображений обрабатывать одновременно
MAX_CONCURRENT_HASHES=4

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
